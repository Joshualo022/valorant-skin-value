# Supabase Postgres connection strings.
# DATABASE_URL: pooled connection (port 6543, pgbouncer) — used by the running app at runtime.
# DIRECT_URL:   direct connection (port 5432) — used by Prisma CLI for migrations/introspection only.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project API settings (Settings -> API Keys).
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[publishable-key]"

# Upstash Redis — powers API rate limiting (see src/lib/rate-limit.ts).
# Server-only, never NEXT_PUBLIC. Optional: if unset, rate limiting is inert
# (fail-open) and the app runs normally — set these to actually enforce limits.
# Named KV_REST_API_* (not the "native" UPSTASH_REDIS_REST_* names) because
# that's what Vercel's Marketplace integration for Upstash actually injects —
# a legacy-KV-branded prefix on a real Upstash database. If provisioning by
# hand instead (https://console.upstash.com), copy its REST URL/token in
# under these same names.
KV_REST_API_URL="https://[endpoint].upstash.io"
KV_REST_API_TOKEN="[rest-token]"
